{
  "name": "everything-backend",
  "version": "0.4.0",
  "description": "Backend engineering Agent Skills for Claude Code, Claude.ai, OpenCode, Cursor and Antigravity, with an installable CLI and a Claude Code plugin.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeworksID/everything-backend.git"
  },
  "bugs": {
    "url": "https://github.com/codeworksID/everything-backend/issues"
  },
  "homepage": "https://github.com/codeworksID/everything-backend#readme",
  "keywords": [
    "opencode",
    "skills",
    "backend",
    "cli",
    "npx",
    "claude-code",
    "claude-skills",
    "agent-skills"
  ],
  "bin": {
    "everything-backend": "scripts/install.js"
  },
  "files": [
    ".agents/skills",
    "scripts/install.js",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node ./scripts/install.js",
    "install:skills": "node ./scripts/install.js",
    "install:skills:dry": "node ./scripts/install.js --dry-run --target ./tmp-skills",
    "check": "node ./scripts/check-package.js",
    "test": "node ./scripts/test-scripts.js",
    "build:claude": "node ./scripts/build-claude-skills.js",
    "prepublishOnly": "node ./scripts/check-package.js && node ./scripts/test-scripts.js"
  },
  "engines": {
    "node": ">=18"
  }
}
